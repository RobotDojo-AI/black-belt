{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/generate-public-truth.js",
  "outputDirectory": "apps",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.clarity.ms https://scripts.clarity.ms; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://robotdojo.ai https://*.robotdojo.ai https://relay.robotdojo.ai https://www.google-analytics.com https://region1.google-analytics.com https://www.google.com https://www.clarity.ms https://*.clarity.ms; frame-ancestors 'none'" }
      ]
    }
  ],
  "redirects": [
    { "source": "/login", "destination": "/connect", "permanent": false },
    { "source": "/finetuning", "destination": "/", "permanent": true },
    { "source": "/architecture", "destination": "/", "permanent": true },
    { "source": "/setup", "destination": "/#install", "permanent": false },
    { "source": "/subscription", "destination": "/", "permanent": false },
    { "source": "/account/subscription.html", "destination": "/", "permanent": false },
    { "source": "/apps/account/subscription.html", "destination": "/", "permanent": false },
    { "source": "/accounts/subscription.html", "destination": "/", "permanent": false },
    { "source": "/account/billing", "destination": "/", "permanent": false },
    { "source": "/accounts/billing", "destination": "/", "permanent": false },
    { "source": "/workbench", "destination": "/chat", "permanent": true },
    { "source": "/workbench/:path*", "destination": "/chat", "permanent": true },
    { "source": "/apps/workbench", "destination": "/chat", "permanent": true },
    { "source": "/apps/workbench/:path*", "destination": "/chat", "permanent": true },
    { "source": "/account/workbenches", "destination": "/chat", "permanent": true },
    { "source": "/account/workbenches/:path*", "destination": "/chat", "permanent": true },
    { "source": "/account/feature-request", "destination": "/account/how-to", "permanent": true },
    { "source": "/account/feature-requests", "destination": "/account/how-to", "permanent": true },
    { "source": "/accounts/feature-request", "destination": "/account/how-to", "permanent": true },
    { "source": "/accounts/feature-requests", "destination": "/account/how-to", "permanent": true },
    { "source": "/account/referrals", "destination": "/account/how-to", "permanent": true },
    { "source": "/accounts/referrals", "destination": "/account/how-to", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/sw.js", "destination": "/static/sw.js" },
    { "source": "/version.json", "destination": "/static/version.json" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/ask", "destination": "/faq/index.html" },
    { "source": "/connect", "destination": "/login" },
    { "source": "/topics", "destination": "/viewer/index.html" },
    { "source": "/topics/:path*", "destination": "/viewer/index.html" },
    { "source": "/docs", "destination": "/viewer/index.html" },
    { "source": "/docs/:path*", "destination": "/viewer/index.html" },
    { "source": "/agents", "destination": "/viewer/index.html" },
    { "source": "/agents/:path*", "destination": "/viewer/index.html" },
    { "source": "/user", "destination": "/viewer/index.html" },
    { "source": "/user/:path*", "destination": "/viewer/index.html" },
    { "source": "/people/:path*", "destination": "/viewer/index.html" },
    { "source": "/companies/:path*", "destination": "/viewer/index.html" },
    { "source": "/places/:path*", "destination": "/viewer/index.html" },
    { "source": "/entities/:path*", "destination": "/viewer/index.html" },
    { "source": "/workbenches/:path*", "destination": "/viewer/index.html" },
    { "source": "/auth-google-guidance", "destination": "/auth-google-guidance.html" },
    { "source": "/install.sh", "destination": "/static/install.sh" },
    { "source": "/uninstall.sh", "destination": "/static/uninstall.sh" },
    { "source": "/auth/google/guidance", "destination": "/auth-google-guidance" },
    { "source": "/api/public-chat/stream", "destination": "/api/public-chat" },
    { "source": "/api/public-chat/onboarding-share", "destination": "/api/public-chat" },
    { "source": "/api/public-chat/health", "destination": "/api/public-chat" },
    { "source": "/api/bb-revocation.json", "destination": "/api/bb-revocation" },
    { "source": "/google6102e1268ece5472", "destination": "/static/google6102e1268ece5472" },
    { "source": "/google47ea960176c26d43", "destination": "/static/google47ea960176c26d43" },
    { "source": "/sitemap.xml", "destination": "/static/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/static/robots.txt" },
    { "source": "/llms.txt", "destination": "/static/llms.txt" },
    { "source": "/llms-full.txt", "destination": "/static/llms-full.txt" },
    { "source": "/og-image.png", "destination": "/static/og-image.png" },
    { "source": "/04cd6a859b58d643813c2a7187934426.txt", "destination": "/static/04cd6a859b58d643813c2a7187934426.txt" }
  ]
}
