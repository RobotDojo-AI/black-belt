<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Robot Dojo — disk watchdog.
  Every 300s — bounds Robot Dojo launchd logs so disk pressure cannot take down
  relay-critical local services.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.robotdojo.disk-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>__ROBOTDOJO_RUNTIME__</string>
    <string>__ROBOTDOJO_HOME__/scripts/disk-watchdog.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROBOTDOJO_HOME__</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>Nice</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__CONFIG__/logs/robotdojo-disk-watchdog.out.log</string>

  <key>StandardErrorPath</key>
  <string>__CONFIG__/logs/robotdojo-disk-watchdog.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>USER</key>
    <string>__USER__</string>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>ROBOTDOJO_CONFIG</key>
    <string>__CONFIG__</string>
    <key>ROBOTDOJO_DISK_WATCHDOG_MAX_LOG_BYTES</key>
    <string>10485760</string>
    <key>ROBOTDOJO_DISK_WATCHDOG_KEEP_LOG_BYTES</key>
    <string>1048576</string>
    <key>ROBOTDOJO_DISK_WATCHDOG_FLOOR_GB</key>
    <string>8</string>
  </dict>
</dict>
</plist>
