<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Robot Dojo — topic taxonomy edit watcher.
  Every 60s — detects user edits to user_topics and triggers reclassification
  of conversations that intersect the edited topic. Disabled at boot
  (RunAtLoad=false) — first run waits for the interval to elapse so server
  boot isn't slowed.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.robotdojo.topic-edit-watcher</string>

  <key>ProgramArguments</key>
  <array>
    <string>__ROBOTDOJO_RUNTIME__</string>
    <string>__ROBOTDOJO_HOME__/scripts/topic-edit-watcher.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROBOTDOJO_HOME__</string>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>ProcessType</key>
  <string>Background</string>

  <key>LowPriorityIO</key>
  <true/>

  <key>Nice</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__CONFIG__/logs/robotdojo-topic-edit-watcher.out.log</string>

  <key>StandardErrorPath</key>
  <string>__CONFIG__/logs/robotdojo-topic-edit-watcher.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>USER</key>
    <string>__USER__</string>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>GEMINI_EMBED_RPM</key>
    <string>100</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>ROBOTDOJO_HOME</key>
    <string>__ROBOTDOJO_HOME__</string>
    <key>ROBOTDOJO_CONFIG</key>
    <string>__CONFIG__</string>
    <key>ROBOTDOJO_DB</key>
    <string>__CONFIG__/robotdojo.db</string>
    <key>ROBOTDOJO_TOPIC_WATCHER_SLICE_LIMIT</key>
    <string>1</string>
    <key>ROBOTDOJO_TOPIC_WATCHER_RECLASSIFY_MAX_SECONDS</key>
    <string>120</string>
    <key>ROBOTDOJO_ALLOW_PLAINTEXT</key>
    <string>1</string>
  </dict>
</dict>
</plist>
