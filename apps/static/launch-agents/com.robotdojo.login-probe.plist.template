<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Robot Dojo — apex login health probe.
  Every 60s — round-trips a cookie-session login against the public apex
  to catch auth regressions before users notice.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.robotdojo.login-probe</string>

  <key>ProgramArguments</key>
  <array>
    <string>__ROBOTDOJO_RUNTIME__</string>
    <string>__ROBOTDOJO_HOME__/scripts/login-probe.js</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__ROBOTDOJO_HOME__</string>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>Nice</key>
  <integer>10</integer>

  <key>StandardOutPath</key>
  <string>__CONFIG__/logs/robotdojo-login-probe.out.log</string>

  <key>StandardErrorPath</key>
  <string>__CONFIG__/logs/robotdojo-login-probe.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>USER</key>
    <string>__USER__</string>
    <key>NODE_ENV</key>
    <string>production</string>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>ROBOTDOJO_LOGIN_PROBE_REMOTE_FAILURES</key>
    <string>1</string>
  </dict>
</dict>
</plist>
