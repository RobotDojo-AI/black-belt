{
  "name": "robotdojo",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "license": "MIT AND Elastic-2.0",
  "description": "Personal AI operating system. Foundation models forgot about you. Robot Dojo remembers.",
  "main": "index.js",
  "scripts": {
    "bundle-faq": "node scripts/generate-public-truth.js",
    "public-truth": "node scripts/generate-public-truth.js",
    "prebuild": "node scripts/generate-public-truth.js",
    "start": "node index.js",
    "dev": "NODE_ENV=development node index.js",
    "migrate": "node scripts/migrate.js",
    "onboard": "node scripts/onboard.js",
    "nightly": "node scripts/nightly.js",
    "token": "node scripts/token.js",
    "belt-check": "node scripts/belt-check.js",
    "test": "node --test tests/*.test.js",
    "qa:memory": "node scripts/qa/memory-magic-audit.js",
    "qa:memory:live-context": "node scripts/qa/memory-live-context-audit.js",
    "qa:data-pipeline": "node scripts/qa/boring-data-pipeline-audit.js --strict",
    "qa:data-pipeline:complete": "node scripts/qa/boring-data-pipeline-audit.js --strict --require-complete",
    "qa:first-session": "node scripts/qa/run.js https://robotdojo.ai --headed first-session-launch.spec.js",
    "qa:first-session:headless": "node scripts/qa/run.js https://robotdojo.ai --headless first-session-launch.spec.js",
    "server:restart": "launchctl unload ~/Library/LaunchAgents/com.robotdojo.server.plist && sleep 1 && launchctl load ~/Library/LaunchAgents/com.robotdojo.server.plist",
    "server:stop": "launchctl unload ~/Library/LaunchAgents/com.robotdojo.server.plist",
    "server:start": "launchctl load ~/Library/LaunchAgents/com.robotdojo.server.plist",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@anthropic-ai/sdk": "^0.39.0",
    "@hono/node-server": "^1.13.0",
    "@huggingface/transformers": "^4.2.0",
    "ai": "^6.0.168",
    "ajv": "^8.18.0",
    "better-sqlite3": "^11.7.0",
    "better-sqlite3-multiple-ciphers": "^11.10.0",
    "email-reply-parser": "^2.3.5",
    "exceljs": "^4.4.0",
    "hono": "^4.7.0",
    "humanparser": "^2.7.0",
    "jszip": "^3.10.1",
    "lru-cache": "^11.3.6",
    "mammoth": "^1.8.0",
    "marked": "^18.0.3",
    "pagedjs": "^0.4.3",
    "pdf-parse": "^2.4.5",
    "sqlite-vec": "^0.1.6",
    "undici": "^7.25.0",
    "usearch": "^2.25.1"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/tap-runner": "^9.6.1",
    "acme-client": "^5.4.0"
  }
}
